{
  "name": "aux-command",
  "version": "0.3.0",
  "description": "Auxillo's Linux-native remote operations workstation for SSH, SFTP, FTP, FTPS, tunnels, RDP, VNC, Mosh, Telnet, serial consoles and local shells.",
  "main": "src/main/index.cjs",
  "desktopName": "aux-command.desktop",
  "author": "Auxillo <https://auxillo.tech>",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check-syntax.cjs && node --test test/*.test.cjs",
    "pack": "electron-builder --dir --linux",
    "dist": "electron-builder --linux AppImage deb rpm",
    "dist:x64": "node scripts/release-metadata.cjs && bash scripts/build-linux-x64.sh",
    "smoke:cdp": "python3 scripts/e2e-cdp-smoke.py",
    "soak:cdp": "python3 scripts/soak-cdp.py",
    "release:metadata": "node scripts/release-metadata.cjs",
    "release:manifest": "AUX_COMMAND_GPG_KEY=FAC028574B9C6875D10DA4DC6443E86108ABD2A2 node scripts/release-metadata.cjs && bash scripts/source-archives.sh && node scripts/release-manifest.cjs",
    "release:verify": "AUX_COMMAND_GPG_FINGERPRINT=FAC028574B9C6875D10DA4DC6443E86108ABD2A2 node scripts/verify-release.cjs"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "6.0.2",
    "electron-updater": "6.8.9",
    "openpgp": "6.3.1",
    "ssh2": "1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.8",
    "dir-compare": "5.0.0",
    "ejs": "6.0.1",
    "filelist": "2.0.2",
    "glob": "13.0.6",
    "jake": "12.10.1",
    "minimatch": "10.2.5",
    "rimraf": "6.1.3",
    "temp": "0.9.4"
  },
  "build": {
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "appId": "tech.auxillo.command",
    "productName": "Aux Command",
    "artifactName": "Aux-Command-${version}-${arch}.${ext}",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Auxillo-Tech",
        "repo": "Aux-Command",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt",
      "SIGNING_KEY.asc",
      "build/icons/256x256.png"
    ],
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "executableName": "aux-command",
      "syncDesktopName": true,
      "category": "Network",
      "synopsis": "Secure remote operations workstation",
      "description": "Manage SSH, SFTP, FTP, FTPS, tunnels, RDP, VNC, Mosh, Telnet and serial sessions from one Linux desktop application.",
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "openssh-client",
        "python3",
        "iputils-ping",
        "traceroute",
        "dnsutils",
        "whois"
      ],
      "recommends": [
        "freerdp2-x11 | freerdp3-x11",
        "xvfb",
        "x11vnc",
        "mosh"
      ]
    },
    "rpm": {
      "depends": [
        "openssh-clients",
        "python3",
        "iputils",
        "traceroute",
        "bind-utils",
        "whois"
      ]
    },
    "asarUnpack": [
      "src/main/helpers/process_guard.py",
      "src/main/helpers/pty_bridge.py",
      "src/main/helpers/serial_bridge.py",
      "src/main/helpers/telnet_bridge.py"
    ]
  },
  "homepage": "https://auxillo.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Auxillo-Tech/Aux-Command.git"
  },
  "bugs": {
    "url": "https://github.com/Auxillo-Tech/Aux-Command/issues"
  },
  "keywords": [
    "ssh",
    "sftp",
    "ftp",
    "ftps",
    "terminal",
    "linux",
    "rdp",
    "vnc",
    "mosh",
    "tunnel",
    "serial"
  ]
}
